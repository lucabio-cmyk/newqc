# =============================================================================
# QConnect-AI Edge - environment configuration (copy to .env and fill in)
# -----------------------------------------------------------------------------
# Operationally sensitive values; .env is git-ignored. docker-compose reads this
# file via `env_file: .env`.
# =============================================================================

# --- Laboratory identity ---
LAB_ID=lab-genova-001
LAB_NAME=Ospedale San Martino - Sierologia

# --- Cloud connection ---
# Base URL of the central cloud API (no trailing slash).
CLOUD_URL=https://cloud.qconnect-ai.example.com
# Per-lab JWT used as "Authorization: Bearer <token>". Keep this secret.
LAB_AUTH_TOKEN=replace-with-per-lab-jwt

# --- Analyzer / HL7 ingestion ---
ANALYZER_HOST=10.20.0.11
ANALYZER_PORT=2575
# MLLP listen port for inbound HL7 from analyzers.
HL7_LISTEN_PORT=2575
# Set true to start the HL7/MLLP listener inside the inference service.
ENABLE_HL7=false

# --- Sync daemon behaviour ---
# Seconds between cloud sync cycles.
SYNC_INTERVAL=300
# Max backoff attempts per network operation before deferring to the next cycle.
RETRY_MAX_ATTEMPTS=10

# --- Local storage ---
# Path to the SQLite cache inside the container (mounted volume).
DB_PATH=/data/qc_cache.db

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
