# =====================================================================
# QConnect-AI Cloud :: environment template
# ---------------------------------------------------------------------
# Copy to `.env` and adjust. NEVER commit a real `.env` (see .gitignore).
# The hostnames below match the docker-compose service names.
# =====================================================================

# --- service ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- primary Postgres ---
POSTGRES_USER=qconnect
POSTGRES_PASSWORD=qconnect
POSTGRES_DB=qconnect
DATABASE_URL=postgresql+asyncpg://qconnect:qconnect@postgres:5432/qconnect

# --- TimescaleDB (time-series) ---
TIMESCALE_USER=qconnect
TIMESCALE_PASSWORD=qconnect
TIMESCALE_DB=qconnect_ts
TIMESCALE_URL=postgresql+asyncpg://qconnect:qconnect@timescaledb:5432/qconnect_ts

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Neo4j (RCA knowledge graph) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=qconnect-neo4j
# Combined auth string consumed by the neo4j image (user/password):
NEO4J_AUTH=neo4j/qconnect-neo4j

# --- RabbitMQ (federated learning message bus) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# --- security ---
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=86400
REQUIRE_AUTH=false

# --- downstream service URLs ---
ML_INFERENCE_URL=http://ml-inference:8001
FEDERATED_LEARNING_URL=http://federated-learning:8002
RCA_CAPA_URL=http://rca-capa:8003
ANALYTICS_URL=http://analytics:8004
ML_INFERENCE_TIMEOUT_SECONDS=2.0
